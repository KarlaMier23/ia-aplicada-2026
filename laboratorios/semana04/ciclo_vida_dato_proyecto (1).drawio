        <mxCell id="d1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFCCCC;strokeColor=#FF0000;fontSize=11;fontStyle=1;" value="D1: Ubicación de parques y áreas verdes" vertex="1">
